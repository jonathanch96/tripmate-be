APP_ENV=local
APP_PORT=8080
APP_SHUTDOWN_TIMEOUT=15s
DB_HOST=localhost
DB_PORT=5432
POSTGRES_HOST_PORT=5432
DB_USER=tripmate
DB_PASSWORD=tripmate
DB_NAME=tripmate
DB_SCHEMA=tripmate
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_AUTO_MIGRATE=false
JWT_ACCESS_SECRET=local-access-secret-change-me-32-bytes
JWT_REFRESH_SECRET=local-refresh-secret-change-me-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
CORS_ALLOWED_ORIGINS=http://localhost:3000
STORAGE_LOCAL_ROOT=./var/receipts
STORAGE_PUBLIC_URL=http://localhost:8080/api/v1/receipt-images
# Set STORAGE_ENDPOINT/credentials to use MinIO or S3 instead of local filesystem storage.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=tripmate-receipts
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OCR_TIMEOUT=30s
