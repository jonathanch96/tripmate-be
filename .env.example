APP_ENV=local
APP_PORT=8080
APP_SHUTDOWN_TIMEOUT=15s
DB_HOST=localhost
DB_PORT=5432
POSTGRES_HOST_PORT=5432
DB_USER=tripmate
DB_PASSWORD=tripmate
DB_NAME=tripmate
DB_SCHEMA=tripmate
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_AUTO_MIGRATE=true
JWT_ACCESS_SECRET=local-access-secret-change-me-32-bytes
JWT_REFRESH_SECRET=local-refresh-secret-change-me-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
CORS_ALLOWED_ORIGINS=http://localhost:3000
