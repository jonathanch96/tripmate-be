APP_ENV=local
APP_PORT=8080
APP_SHUTDOWN_TIMEOUT=15s
DB_HOST=localhost
DB_PORT=5432
POSTGRES_HOST_PORT=5432
DB_USER=tripmate
DB_PASSWORD=tripmate
DB_NAME=tripmate
DB_SCHEMA=tripmate
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_AUTO_MIGRATE=false
JWT_ACCESS_SECRET=local-access-secret-change-me-32-bytes
JWT_REFRESH_SECRET=local-refresh-secret-change-me-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# OAuth client ID from Google Cloud Console (Credentials > OAuth 2.0 Client IDs). Must match the
# GOOGLE_CLIENT_ID the frontend requests ID tokens with. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
# Operator break-glass login: when true, MASTER_PASSWORD_HASH signs in as ANY existing email,
# regardless of that account's own password. Off by default - leave false unless you need it.
# Generate the hash with: go run ./tools/hashpassword
#
# If this .env is read by Docker Compose (docker-compose.yml's env_file, or
# docker-compose.prod.yml's ${MASTER_PASSWORD_HASH}), double every literal $ as $$, or Compose
# will treat "$2a", "$10", etc. as variable references and silently blank them out:
#   MASTER_PASSWORD_HASH=$$2a$$10$$examplesaltandhashhere
# Running the Go binary directly (no Compose) - a single, unescaped $ is correct instead; just
# don't wrap the value in double quotes, since godotenv expands $ the same way inside those.
MASTER_PASSWORD_ENABLED=false
MASTER_PASSWORD_HASH=
CORS_ALLOWED_ORIGINS=http://localhost:3000
STORAGE_LOCAL_ROOT=./var/receipts
STORAGE_PUBLIC_URL=http://localhost:8080/api/v1/receipt-images
# Set STORAGE_ENDPOINT/credentials to use MinIO or S3 instead of local filesystem storage.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=tripmate-receipts
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OCR_TIMEOUT=30s
